# =============================================================================
# Root .htaccess — for /var/www/html/hackathon (served at aiu.edu.eg/hackathon)
#
# Pairs with the root index.php that bootstraps Laravel from this directory.
# Static assets (css, js, img, fonts, the storage symlink) still live inside
# public/ — this .htaccess transparently serves them from there.
# =============================================================================

<IfModule mod_rewrite.c>
    Options -Indexes -MultiViews +FollowSymLinks

    RewriteEngine On
    RewriteBase /hackathon/

    # ---- Pass auth/csrf headers through to PHP -----------------------------
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # ---- Force HTTPS (uncomment after the SSL cert is provisioned) ---------
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ---- Drop trailing slash on non-folder URLs ----------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # ---- If a user typed /public/... explicitly, redirect away -------------
    RewriteCond %{THE_REQUEST} \s/hackathon/public/(.*)\sHTTP [NC]
    RewriteRule ^ /hackathon/%1 [L,R=301]

    # ---- Serve static assets from public/ ----------------------------------
    # Anything that physically exists inside public/ (css, js, img, favicon,
    # robots.txt, the storage symlink, fonts, etc.) is served from there.
    RewriteCond %{DOCUMENT_ROOT}/hackathon/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]
    RewriteCond %{DOCUMENT_ROOT}/hackathon/public/$1 -d
    RewriteRule ^(.+)$ public/$1 [L]

    # ---- Everything else → Laravel via root index.php ----------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# -----------------------------------------------------------------------------
# Block direct access to sensitive files
# -----------------------------------------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)\.(env|env\..*|log|md|json|lock|yml|yaml|xml|sql|sqlite|bak|swp|sh|ini|conf|dist|example)$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|webpack\.mix\.js|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js|README|LICENSE)$">
    Require all denied
</FilesMatch>

# Block direct browsing of Laravel internals
RedirectMatch 403 ^/hackathon/(app|bootstrap|config|database|resources|routes|tests|vendor|nextCityAiHakathon)(/|$)

# storage/ MUST stay blocked (logs, sessions, cache live there)
RedirectMatch 403 ^/hackathon/storage(/|$)

# index.php at the root is the entry point — keep it readable
<Files "index.php">
    Require all granted
</Files>

AddDefaultCharset UTF-8
