# =============================================================================
# Root .htaccess — DELIBERATELY MINIMAL
#
# In production we use an Apache vhost Alias (/hackathon → public/) so this
# file is not needed for routing. Keeping it ONLY to block direct access if
# anyone ever browses /var/www/html/hackathon/ directly.
#
# vhost config: docs/deployment/hackathon-apache.conf
# Routing happens entirely in public/.htaccess.
# =============================================================================

Options -Indexes -MultiViews

# Block direct access to sensitive files / directories
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)\.(env|env\..*|log|md|json|lock|yml|yaml|xml|sql|sqlite|bak|swp|sh|ini|conf|dist|example)$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|webpack\.mix\.js|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js|README|LICENSE)$">
    Require all denied
</FilesMatch>

# NOTE: do NOT block /hackathon/storage/ here — that URL resolves to
# public/storage (the `php artisan storage:link` symlink) which legitimately
# serves user uploads. The project's real storage/ dir is unreachable because
# the vhost Alias maps /hackathon → public/ only.
RedirectMatch 403 ^/hackathon/(app|bootstrap|config|database|resources|routes|tests|vendor|nextCityAiHakathon)(/|$)

AddDefaultCharset UTF-8
