# =============================================================================
# Production .env — aiu.edu.eg/hackathon
#
# After uploading the project to /var/www/html/hackathon/ on the Ubuntu server:
#   cp .env.production .env
#   php artisan key:generate
#   nano .env                       # fill in DB_USERNAME, DB_PASSWORD, MAIL_*
#   php artisan migrate --force
#   php artisan db:seed --force
#   php artisan config:cache route:cache view:cache
# =============================================================================

APP_NAME="Next City AI Hackathon"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="Africa/Cairo"
APP_URL=https://aiu.edu.eg/hackathon

ASSET_URL=https://aiu.edu.eg/hackathon

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -------------------------------------------------------- Logging
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -------------------------------------------------------- Database
# CHANGE these to match the credentials you create in MySQL/MariaDB on the server.
# Quick setup on the Ubuntu host:
#   sudo mysql -u root
#   CREATE DATABASE hackathon_dashboard CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'hackathon'@'localhost' IDENTIFIED BY 'CHANGE_ME_STRONG_PASSWORD';
#   GRANT ALL PRIVILEGES ON hackathon_dashboard.* TO 'hackathon'@'localhost';
#   FLUSH PRIVILEGES;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hackathon_dashboard
DB_USERNAME=hackathon
DB_PASSWORD=

# -------------------------------------------------------- Sessions / Cache / Queue
# DB-backed because shared servers don't have Redis available reliably.
SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/hackathon
SESSION_DOMAIN=aiu.edu.eg
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=hackathon

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=pusher

FILESYSTEM_DISK=public

# -------------------------------------------------------- Pusher (real-time)
# Sign up at https://pusher.com/, create a "Channels" app, and paste the keys.
# Cluster "eu" is recommended for Egypt.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=eu

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# -------------------------------------------------------- Mail
# Pick one strategy. SMTP via the AIU mail server is recommended.
MAIL_MAILER=smtp
MAIL_HOST=mail.aiu.edu.eg
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="acie@aiu.edu.eg"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------- Trusted proxies
# If you ever put Cloudflare / a reverse proxy in front of Apache, set this
# to "*" so Laravel trusts X-Forwarded-* headers.
TRUSTED_PROXIES=
TRUSTED_HOSTS=aiu.edu.eg

VITE_APP_NAME="${APP_NAME}"
